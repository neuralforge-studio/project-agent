#!/bin/bash
# Entry point of project-board: a tmux TUI of every registered project team.
# Source: project-agent repo tools/project-board. Install: ln -s <this file> ~/.local/bin/project-board
entry="${BASH_SOURCE[0]}"
[[ ! -L "$entry" ]] || entry="$(readlink -f -- "$entry")"
[[ "$entry" == */* ]] || entry="./$entry"
ROOT="$(CDPATH= cd -P -- "${entry%/*}/.." && pwd -P)"
source "$ROOT/../python-launcher.sh"
project_agent_select_python
project_agent_read_boot
if [ -z "$PY" ]; then
    echo "The configured Python interpreter is unavailable." >&2
    exit 5
fi
export PYTHONPATH="$ROOT${PROJECT_AGENT_PYTHONPATH:+:$PROJECT_AGENT_PYTHONPATH}"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
# Only the TUI commands import textual from the interpreter's site-packages. The tmux hooks and the
# toggle/click keys (sync, click, toggle) are standard library only and run at every window change: they
# skip the site step and start from the bundle (`-m project_board`, after the bundle reader).
# The two windows (cr, popup) start from the bundle as well: textual and what it imports are in it (guarded by
# their package metadata), and the interpreter's installed packages come last on the path because `-S` skips the
# site step that would add them. A window is opened by a click and imports about 400 modules otherwise; on NFS
# every module is a file to open. Where textual is not found that way (another layout of the installed packages)
# the command starts again the ordinary way.
command="${1:-}"
[[ "$command" != --config ]] || command="${3:-}"
case "$command" in
    sync|click|toggle)
        exec "$PY" -S -c "$PROJECT_AGENT_BOOT
import sys
_project_agent_bundle(sys.argv.pop(1))
import runpy
runpy.run_module('project_board', run_name='__main__', alter_sys=True)" "$PROJECT_AGENT_LAUNCHER_DIR" "$@" ;;
    cr|popup)
        exec "$PY" -S -c "$PROJECT_AGENT_BOOT
import sys
_project_agent_bundle(sys.argv.pop(1))
sys.path.append('%s/lib/python%d.%d/site-packages' % (sys.prefix, *sys.version_info[:2]))
try:
    import textual
except ImportError:
    import os
    os.execv(sys.executable, [sys.executable, '-m', 'project_board', *sys.argv[1:]])
import runpy
runpy.run_module('project_board', run_name='__main__', alter_sys=True)" "$PROJECT_AGENT_LAUNCHER_DIR" "$@" ;;
esac
exec "$PY" -m project_board "$@"
