#!/bin/bash
# Entry point of project-board: a tmux TUI of every registered project team.
# Source: project-agent repo tools/project-board. Install: ln -s <this file> ~/.local/bin/project-board
entry="${BASH_SOURCE[0]}"
[[ ! -L "$entry" ]] || entry="$(readlink -f -- "$entry")"
[[ "$entry" == */* ]] || entry="./$entry"
ROOT="$(CDPATH= cd -P -- "${entry%/*}/.." && pwd -P)"
source "$ROOT/../python-launcher.sh"
project_agent_select_python
project_agent_read_boot
if [ -z "$PY" ]; then
    echo "The configured Python interpreter is unavailable." >&2
    exit 5
fi
export PYTHONPATH="$ROOT${PROJECT_AGENT_PYTHONPATH:+:$PROJECT_AGENT_PYTHONPATH}"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
# Only the popup TUI commands import textual from the interpreter's site-packages. The tmux hooks, the
# toggle/click keys (sync, click, toggle) and the commands the sidebar runs for its clicks (BOARD-018) are
# standard library only and run at every window change or click: they skip the site step and start from
# the bundle (`-m project_board`, after the bundle reader).
command_name="${1:-}"
[[ "$command_name" != --config ]] || command_name="${3:-}"
case "$command_name" in
    sync|click|toggle|open-decision|open-cr|toggle-fold|liveness)
        exec "$PY" -S -c "$PROJECT_AGENT_BOOT
import sys
_project_agent_bundle(sys.argv.pop(1))
import runpy
runpy.run_module('project_board', run_name='__main__', alter_sys=True)" "$PROJECT_AGENT_LAUNCHER_DIR" "$@" ;;
esac
exec "$PY" -m project_board "$@"
