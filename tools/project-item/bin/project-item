#!/bin/bash
# Entry point of project-item: CR and decision items of a registered project.
# Source: project-agent repo tools/project-item. Install: ln -s <this file> ~/.local/bin/project-item
entry="${BASH_SOURCE[0]}"
[[ ! -L "$entry" ]] || entry="$(readlink -f -- "$entry")"
[[ "$entry" == */* ]] || entry="./$entry"
ROOT="$(CDPATH= cd -P -- "${entry%/*}/.." && pwd -P)"
source "$ROOT/../python-launcher.sh"
project_agent_select_python
project_agent_read_boot
if [ -z "$PY" ]; then
    echo "The configured Python interpreter is unavailable." >&2
    exit 5
fi
export PYTHONPATH="$ROOT"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
# `-m project_item`, after the bundle reader: the tool's and the standard library's modules come from one file.
exec "$PY" -S -c "$PROJECT_AGENT_BOOT
import sys
_project_agent_bundle(sys.argv.pop(1))
import runpy
runpy.run_module('project_item', run_name='__main__', alter_sys=True)" "$PROJECT_AGENT_LAUNCHER_DIR" "$@"
