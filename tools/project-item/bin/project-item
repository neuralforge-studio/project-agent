#!/bin/bash
# Entry point of project-item: CR and decision items of a registered project.
# Source: project-agent repo tools/project-item. Install: ln -s <this file> ~/.local/bin/project-item
entry="${BASH_SOURCE[0]}"
[[ ! -L "$entry" ]] || entry="$(readlink -f -- "$entry")"
[[ "$entry" == */* ]] || entry="./$entry"
ROOT="$(CDPATH= cd -P -- "${entry%/*}/.." && pwd -P)"
source "$ROOT/../python-launcher.sh"
project_agent_select_python
if [ -z "$PY" ]; then
    echo "The configured Python interpreter is unavailable." >&2
    exit 5
fi
export PYTHONPATH="$ROOT"
export PYTHONNOUSERSITE=1
unset PYTHONHOME
exec "$PY" -S -m project_item "$@"
